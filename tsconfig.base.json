{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@lister/shared/api-contracts": [
        "./packages/shared/api-contracts/src/index.ts"
      ],
      "@lister/web/util-theme": ["./packages/web/util-theme/src/index.ts"],
      "@lister/web/ui": ["./packages/web/ui/src/index.ts"],
      "@lister/web/feature-lists": [
        "./packages/web/feature-lists/src/index.ts"
      ],
      "@lister/web/feature-runs": ["./packages/web/feature-runs/src/index.ts"],
      "@lister/web/feature-space": [
        "./packages/web/feature-space/src/index.ts"
      ],
      "@lister/web/util-pwa": ["./packages/web/util-pwa/src/index.ts"],
      "@lister/api/data-access-db": [
        "./packages/api/data-access-db/src/index.ts"
      ],
      "@lister/shared/domain": ["./packages/shared/domain/src/index.ts"],
      "@lister/shared/sync-protocol": [
        "./packages/shared/sync-protocol/src/index.ts"
      ],
      "@lister/api/feature-sync": ["./packages/api/feature-sync/src/index.ts"],
      "@lister/web/data-access-local-db": [
        "./packages/web/data-access-local-db/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
