{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@lister/shared/api-contracts": [
        "./packages/shared/api-contracts/src/index.ts"
      ],
      "@lister/web/util-theme": ["./packages/web/util-theme/src/index.ts"],
      "@lister/web/ui": ["./packages/web/ui/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
