{
  "name": "lister-web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "lister",
  "sourceRoot": "apps/lister-web/src",
  "tags": ["scope:web", "type:app"],
  "targets": {
    "subset-icons": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/subset-material-symbols.mjs",
        "cwd": "{workspaceRoot}"
      }
    },
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/lister-web",
        "browser": "apps/lister-web/src/main.ts",
        "tsConfig": "apps/lister-web/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/lister-web/public"
          }
        ],
        "styles": [
          "node_modules/@fontsource-variable/roboto/index.css",
          "apps/lister-web/src/material-symbols.css",
          "apps/lister-web/src/styles.scss"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all",
          "serviceWorker": "apps/lister-web/ngsw-config.json",
          "security": { "autoCsp": true }
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "proxyConfig": "apps/lister-web/proxy.conf.json"
      },
      "configurations": {
        "production": {
          "buildTarget": "lister-web:build:production"
        },
        "development": {
          "buildTarget": "lister-web:build:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false,
        "setupFiles": ["apps/lister-web/src/testing/web-storage.ts"]
      }
    }
  }
}
