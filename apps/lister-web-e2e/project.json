{
  "name": "lister-web-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/lister-web-e2e/src",
  "implicitDependencies": ["lister-web", "lister-api"],
  "targets": {
    "e2e": {
      "dependsOn": [
        {
          "projects": ["lister-api"],
          "target": "serve",
          "waitFor": "ready"
        },
        {
          "projects": ["lister-web"],
          "target": "serve",
          "waitFor": "ready"
        }
      ]
    }
  },
  "tags": ["scope:web", "type:e2e"]
}
