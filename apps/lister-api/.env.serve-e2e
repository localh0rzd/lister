# Loaded by Nx for `lister-api:serve-e2e`: the e2e suites get their own database, not the
# developer's data/lister.db. It runs the production build, like serve-prod-e2e, so both e2e
# servers share one build output instead of overwriting each other's.
NODE_ENV=production
PUBLIC_URL=http://localhost:4200
DATABASE_PATH=tmp/e2e/lister.db
# Not a secret: lets the e2e global setup create the first admin (it can't read the log).
LISTER_SETUP_TOKEN=e2e-setup-token-not-a-secret
