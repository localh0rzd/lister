{
  "name": "lister-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/lister-api/src",
  "projectType": "application",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/lister-api/package.json",
        "{workspaceRoot}/dist/apps/lister-api/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/lister-api/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "readyWhen": {
        "signal": true
      },
      "options": {
        "buildTarget": "lister-api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "lister-api:build:development"
        },
        "production": {
          "buildTarget": "lister-api:build:production"
        }
      }
    },
    "serve-e2e": {
      "continuous": true,
      "executor": "@nx/js:node",
      "dependsOn": ["build"],
      "readyWhen": {
        "signal": true
      },
      "options": {
        "buildTarget": "lister-api:build:development",
        "runBuildTargetDependencies": false,
        "watch": false
      }
    },
    "serve-prod": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        {
          "projects": ["lister-web"],
          "target": "build"
        }
      ],
      "options": {
        "command": "node dist/apps/lister-api/main.js",
        "cwd": "{workspaceRoot}",
        "env": {
          "NODE_ENV": "production",
          "PORT": "3100",
          "PUBLIC_URL": "http://localhost:3100",
          "DATABASE_PATH": "data/lister-prod.db",
          "LISTER_DEV_SEED": "true"
        }
      }
    },
    "serve-prod-e2e": {
      "continuous": true,
      "executor": "nx:run-commands",
      "dependsOn": [
        "build",
        {
          "projects": ["lister-web"],
          "target": "build"
        }
      ],
      "options": {
        "command": "node dist/apps/lister-api/main.js",
        "cwd": "{workspaceRoot}",
        "env": {
          "NODE_ENV": "production",
          "PORT": "3100",
          "PUBLIC_URL": "http://localhost:3100",
          "DATABASE_PATH": "tmp/e2e/prod.db",
          "LISTER_DEV_SEED": "true"
        }
      }
    }
  }
}
