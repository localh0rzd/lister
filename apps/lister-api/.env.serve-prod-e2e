# Loaded by Nx for `lister-api:serve-prod-e2e` (the e2e target starts it): the production setup on
# its own, freshly reset database (`reset-e2e-db`).
NODE_ENV=production
PORT=3100
PUBLIC_URL=http://localhost:3100
DATABASE_PATH=tmp/e2e/prod.db
# Not a secret: lets the e2e global setup create the first admin (it can't read the log).
LISTER_SETUP_TOKEN=e2e-setup-token-not-a-secret
